# Copy to .env and fill in. Never commit .env.

# ── Databases ────────────────────────────────────────────────────────
# Original (read-only reference) and working copy the agents modify.
CAMPUS_DB_ORIGINAL=data/campus_customs.db
CAMPUS_DB_PATH=data/campus_customs_new.db

# ── Agent team (Pydantic AI over a Portkey-served model) ────────────
PORTKEY_API_KEY=your-portkey-key-here
MODEL_NAME=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
